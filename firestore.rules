rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Perfil público: qualquer usuário autenticado pode consultar.
    // O próprio usuário pode criar/atualizar o documento do seu perfil.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // Dados privados: somente o próprio usuário.
    match /userPrivate/{uid} {
      allow read, create, update, delete: if isOwner(uid);
    }

    // Conversas diretas: somente participantes.
    match /directConversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update, delete: if signedIn() && request.auth.uid in resource.data.participantIds;
    }

    // Grupos: leitura para integrantes; criação/alteração será refinada nas fases de grupos.
    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn();
      allow update, delete: if signedIn() && request.auth.uid in resource.data.memberIds;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
