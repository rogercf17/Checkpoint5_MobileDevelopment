rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }

    // Perfil público (nome, foto, data de criação)
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'photoUrl', 'createdAt']);

      // Tokens de push do aparelho: só o dono (a API lê via Admin SDK)
      match /devices/{deviceId} {
        allow read, write: if request.auth.uid == uid;
      }
    }

    // Dados cadastrais privados: só o dono (outros usuários via API)
    match /userPrivate/{uid} {
      allow read, write: if request.auth.uid == uid;
    }

    // Grupos: cliente só LÊ (se for integrante). Toda escrita passa pela API (Admin SDK).
    match /groups/{gid} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow write: if false;
    }

    match /directConversations/{cid} {
      allow get: if signedIn() && request.auth.uid in cid.split('_');
      allow list: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds[0] < request.resource.data.participantIds[1]
        && cid == 'direct_' + request.resource.data.participantIds[0] + '_'
          + request.resource.data.participantIds[1];
      allow update, delete: if false;
    }

    // notificationDispatches: só a API (Admin SDK ignora as regras)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
