{
  "rules": {
    ".read": false,
    ".write": false,
    "groupMembers": {
      "$gid": {
        ".read": "auth != null && data.child(auth.uid).exists()"
      }
    },
    "messages": {
      "$cid": {
        ".indexOn": ["createdAt"],
        ".read": "auth != null && ($cid.beginsWith('direct_') ? $cid.contains(auth.uid) : root.child('groupMembers').child($cid).child(auth.uid).exists())",
        "$mid": {
          ".write": "auth != null && !data.exists() && ($cid.beginsWith('direct_') ? $cid.contains(auth.uid) : root.child('groupMembers').child($cid).child(auth.uid).exists())",
          ".validate": "newData.hasChildren(['senderId','text','createdAt','conversationType'])",
          "senderId": { ".validate": "newData.val() === auth.uid" },
          "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "conversationType": { ".validate": "newData.val() === 'direct' || newData.val() === 'group'" },
          "target": { ".validate": true },
          "mentionedUserIds": { ".validate": true },
          "$other": { ".validate": false }
        }
      }
    }
  }
}